{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "tagent",
  "version": "0.1.0",
  "identifier": "com.tagent.app",
  "build": {
    "frontendDist": "../src"
  },
"app": {
      "withGlobalTauri": true,
      "windows": [
      {
        "title": "智能操作助手",
        "width": 500,
        "height": 60,
        "x": 280,
        "y": 40,
        "fullscreen": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": {
      "../dist/tagent-server.exe": "tagent-server.exe"
    },
    "publisher": "tagent",
    "shortDescription": "智能操作助手",
    "longDescription": "演示一次，自动学会并替你完成电脑操作",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis-hooks.nsh"
      },
      "wix": {
        "fragmentPaths": ["wix-uninstall.wxs"]
      }
    }
  }
}
